# คัดลอกค่าจริงไปใส่ใน Render: Service → Environment (ห้ามอัปโหลดไฟล์ที่มีค่าจริงขึ้น GitHub)

# ฐานข้อมูล — จาก Supabase: Connect → Session pooler → URI (แทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูล)
DATABASE_URL=

# Google OAuth — จาก Google Cloud Console → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/auth/google/callback
# (ไม่บังคับ) บอก Google ให้แสดงเฉพาะบัญชีโดเมนนี้ตอนเลือกบัญชี เช่น example.ac.th
GOOGLE_HOSTED_DOMAIN=

# สุ่มข้อความยาว ๆ อย่างน้อย 32 ตัวอักษร (Render: กด Generate ได้)
SESSION_SECRET=

NODE_ENV=production
